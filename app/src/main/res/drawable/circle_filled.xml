<?xml version="1.0" encoding="utf-8"?>
<!--
  A plain filled circle. It is drawn in white so that a tint can colour it,
  which is what lets the play button follow the colour of the album cover.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/white" />
</shape>

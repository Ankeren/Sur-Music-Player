<?xml version="1.0" encoding="utf-8"?>
<!-- Darkens album art behind the bouncing bars. Rounded to the same radius
     as the artwork, so the corners do not show square behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/art_scrim" />
    <corners android:radius="10dp" />
</shape>
